        {
            "community": {
                "id": 155,
                "name": "Pandemonium Of Fear",
                "group_id": "grp_aeb85cb5-e07d-4f9d-824d-0a373f7d9f4a",
                "description": "Founded in AltspaceVR, Pandemonium Of Fear was the original VR Haunt and the first VR haunted attraction to combine live actors, interactive storytelling, and virtual scares into a fully immersive horror experience. Following AltspaceVR’s closure, the Haunt found its new home in VRChat, where it continues to frighten and entertain guests year after year.\n\nThe Haunt returns every Friday and Saturday night in October from 7:00–9:00 PM Pacific (PST - USA). \n\nInterested in becoming part of the nightmare? Scare Actor auditions and Moderator interviews will be held August 28th and 29th.\n\nPandemonium Of Fear -\nCreated by Psychowench Productions\n\nWe Like What Scares You...",
                "createdAt": "2024-10-16T20:20:06.000Z",
